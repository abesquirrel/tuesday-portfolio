---
import { getSpotifyEmbedUrl } from '../utils/spotify';

interface Props {
  spotifyUrl?: string | null;
  compact?: boolean;
  label?: string;
}

const { spotifyUrl, compact = true, label = 'Soundtrack' } = Astro.props;
const embedUrl = getSpotifyEmbedUrl(spotifyUrl || undefined);
const height = compact ? '80' : '152';
---

{
  embedUrl && (
    <div class="spotify-embed-container my-3">
      {label && (
        <div class="spotify-label mb-2">
          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="currentColor"
            class="me-1 text-success inline-block align-middle"
          >
            <path d="M12 0C5.4 0 0 5.4 0 12s5.4 12 12 12 12-5.4 12-12S18.66 0 12 0zm5.521 17.34c-.24.359-.66.48-1.021.24-2.82-1.74-6.36-2.101-10.561-1.141-.418.122-.779-.179-.899-.539-.12-.421.18-.78.54-.9 4.56-1.021 8.52-.6 11.64 1.32.42.18.479.659.301 1.02zm1.44-3.3c-.301.42-.841.6-1.262.3-3.239-1.98-8.159-2.58-11.939-1.38-.479.12-1.02-.12-1.14-.6-.12-.48.12-1.021.6-1.141C9.6 9.9 15 10.561 18.72 12.84c.361.181.54.78.241 1.2zm.12-3.36C15.24 8.4 8.82 8.16 5.16 9.301c-.6.179-1.2-.181-1.38-.721-.18-.601.18-1.2.72-1.381 4.26-1.26 11.28-1.02 15.721 1.621.539.3.719 1.02.419 1.56-.299.421-1.02.599-1.559.3z" />
          </svg>
          <span class="text-uppercase tracking-wider small text-muted font-monospace">
            {label}
          </span>
        </div>
      )}
      <iframe
        src={embedUrl}
        width="100%"
        height={height}
        frameborder="0"
        allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
        loading="lazy"
        class="spotify-iframe"
      />
    </div>
  )
}

<style>
  .spotify-embed-container {
    max-width: 100%;
    border-radius: 12px;
    overflow: hidden;
  }
  .spotify-iframe {
    border-radius: 12px;
    display: block;
    background: transparent;
  }
  .spotify-label {
    font-size: 0.7rem;
    letter-spacing: 0.15em;
    display: flex;
    align-items: center;
    gap: 4px;
  }
</style>
