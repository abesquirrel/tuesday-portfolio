---
// src/components/admin/shared/Modal.astro

interface Props {
  id: string;
  title?: string;
  isOpen: boolean;
  onClose: () => void;
  size?: 'sm' | 'md' | 'lg' | 'xl';
}

const { id, title, isOpen, onClose, size = 'md' } = Astro.props;

const sizes: Record<string, string> = {
  sm: '400px',
  md: '540px',
  lg: '720px',
  xl: '900px'
};
---

<dialog id={id} class="modal-dialog" open={isOpen} data-size={size} onClick={(e) => {
  if (e.target === e.currentTarget) onClose();
}}>
  <div class="modal" role="dialog" aria-modal="true" aria-labelledby={title ? id + '-title' : undefined}>
    {title && (
      <div class="modal-head">
        <h2 id={id + '-title'} class="modal-title">{title}</h2>
        <button class="modal-close" onClick={onClose} aria-label="Close modal">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="18" y1="6" x2="6" y2="18"/>
            <line x1="6" y1="6" x2="18" y2="18"/>
          </svg>
        </button>
      </div>
    )}
    <div class="modal-body">
      <slot />
    </div>
    {Astro.slots.footer && (
      <div class="modal-foot">
        <slot name="footer" />
      </div>
    )}
  </div>
</dialog>

<style>
  .modal-dialog {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.8);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
    z-index: 1000;
    border: none;
    box-shadow: none;
  }
  .modal-dialog::backdrop { background: rgba(0, 0, 0, 0.8); backdrop-filter: blur(4px); }
  .modal-dialog:not([open]) { display: none; }
  .modal {
    background: var(--paper);
    border: 1px solid var(--border2);
    border-radius: var(--r);
    width: 100%;
    max-width: v-bind("sizes[size]");
    max-height: 92vh;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    animation: modalSlideIn 0.2s ease-out;
  }
  @keyframes modalSlideIn { from { opacity: 0; transform: translateY(-20px); } to { opacity: 1; transform: translateY(0); } }
  .modal-head {
    padding: 18px 22px 14px;
    border-bottom: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: space-between;
    position: sticky;
    top: 0;
    background: var(--paper);
    z-index: 1;
  }
  .modal-title {
    font-family: var(--serif);
    font-style: italic;
    font-size: 17px;
    color: var(--amber);
    margin: 0;
  }
  .modal-close {
    background: none;
    border: none;
    color: var(--muted);
    cursor: pointer;
    padding: 4px;
    border-radius: var(--r-sm);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .modal-close:hover { color: var(--text); background: var(--rail); }
  .modal-body { padding: 20px 22px; overflow-y: auto; flex: 1; }
  .modal-foot {
    padding: 14px 22px;
    border-top: 1px solid var(--border);
    display: flex;
    justify-content: flex-end;
    gap: 8px;
    position: sticky;
    bottom: 0;
    background: var(--paper);
  }
  @media (max-width: 768px) {
    .modal-dialog { padding: 10px; }
    .modal { width: 100%; max-width: 100%; margin: 0 auto; max-height: 100vh; }
    .modal-head { padding: 16px 18px 12px; }
    .modal-body { padding: 16px 18px; height: calc(100vh - 120px); }
    .modal-foot { padding: 12px 18px; }
  }
</style>
