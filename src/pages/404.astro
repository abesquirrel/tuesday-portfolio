---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/global.scss';

export const prerender = true;
---

<BaseLayout
  title="404 — Frame Not Found | I Think It Was Tuesday"
  description="The frame or page you were looking for could not be found."
>
  <section class="error-page">
    <div class="container text-center">
      <p class="section-eyebrow">404 — Blank Exposure</p>
      <h1 class="error-title">Frame Not Found</h1>
      <p class="error-sub">
        This roll seems to have come up blank. The image or page you are looking for does not exist or has been moved.
      </p>
      <div class="mt-4">
        <a href="/" class="btn btn-outline-light btn-sm px-4 py-2 error-btn">
          ← Return to Darkroom
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style lang="scss">
  .error-page {
    min-height: 80vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 6rem 1rem;
    background-color: #0e0d0b;
  }

  .error-title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(2.2rem, 5vw, 4rem);
    font-style: italic;
    color: #c8c4bc;
    margin-bottom: 1rem;
  }

  .error-sub {
    font-family: 'Libre Baskerville', Georgia, serif;
    font-size: clamp(0.9rem, 2vw, 1.1rem);
    color: rgba(200, 196, 188, 0.6);
    max-width: 480px;
    margin: 0 auto 2rem;
    line-height: 1.7;
  }

  .error-btn {
    font-family: 'Courier New', monospace;
    font-size: 0.75rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #c8a96e;
    border-color: rgba(200, 169, 110, 0.4);
    border-radius: 0;

    &:hover {
      background-color: #c8a96e;
      color: #0e0d0b;
      border-color: #c8a96e;
    }
  }
</style>
