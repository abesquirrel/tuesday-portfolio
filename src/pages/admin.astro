// src/pages/admin.astro
// ─── Server-side: auth guard + security ──────────────────────────────────
export const prerender = false;

import { getSettings } from '../lib/db';
import bcrypt from 'bcrypt-wasm';

// Initialize bcrypt-wasm
const bcryptReady = bcrypt.init();

// Generate secure random tokens
function generateSecureToken() {
  const array = new Uint8Array(32);
  crypto.getRandomValues(array);
  return Array.from(array, byte => byte.toString(16).padStart(2, '0')).join('');
}

// ─── Environment & DB ───────────────────────────────────────────────────
const env = (Astro.locals as any).runtime?.env;
const db = env?.DB || env?.tuesday_photos || env?.['tuesday-photos'];

// Generate and manage CSRF token
let csrfToken = Astro.cookies.get('csrf_token')?.value;
if (!csrfToken) {
  csrfToken = generateSecureToken();
  Astro.cookies.set('csrf_token', csrfToken, {
    httpOnly: true,
    secure: Astro.url.protocol === 'https:',
    sameSite: 'strict',
    path: '/',
    maxAge: 60 * 60 * 24, // 24 hours
  });
}

// Session management
const sessionCookie = Astro.cookies.get('admin_session')?.value;
const isAuthed = !!sessionCookie;

// Initialize bcrypt
await bcryptReady;

// Get hashed password from env or DB
let ADMIN_PASSWORD_HASH = env?.ADMIN_PASSWORD_HASH ?? import.meta.env.ADMIN_PASSWORD_HASH;
if (!ADMIN_PASSWORD_HASH && db) {
  try {
    const settings = await getSettings(db);
    ADMIN_PASSWORD_HASH = settings.ADMIN_PASSWORD_HASH;
  } catch (e) {
    console.error('Failed to fetch settings:', e);
  }
}

// Migration: hash ADMIN_SECRET if it exists and no hash exists
if (!ADMIN_PASSWORD_HASH && env?.ADMIN_SECRET) {
  ADMIN_PASSWORD_HASH = await bcrypt.hash(env.ADMIN_SECRET, 10);
  console.warn('⚠️ Created password hash from ADMIN_SECRET. Set ADMIN_PASSWORD_HASH in your environment variables.');
}

// Cloud name logic
let CLOUD_NAME = env?.PUBLIC_CLOUDINARY_CLOUD_NAME
              ?? import.meta.env.PUBLIC_CLOUDINARY_CLOUD_NAME
              ?? (typeof p
rocess !== 'undefined' ? process.env.PUBLIC_CLOUDINARY_CLOUD_NAME : undefined);
if (!CLOUD_NAME && db) {
  try {
    const settings = await getSettings(db);
    CLOUD_NAME = settings.PUBLIC_CLOUDINARY_CLOUD_NAME;
  } catch (e) {
    console.error('Failed to fetch settings from DB:', e);
  }
}
if (!CLOUD_NAME) CLOUD_NAME = 'clueless';

let loginError = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  
  // Validate CSRF token on all POST requests
  const csrfFromForm = form.get('csrf_token');
  if (!csrfFromForm || csrfFromForm !== csrfToken) {
    loginError = 'Invalid request. Please refresh the page and try again.';
  } else {
    const action = form.get('action');
    
    if (action === 'login') {
      const pw = form.get('password');
      if (!pw) {
        loginError = 'Password is required.';
      } else if (ADMIN_PASSWORD_HASH) {
        const isValid = await bcrypt.compare(String(pw), ADMIN_PASSWORD_HASH);
        if (isValid) {
          // Generate random session token (not the password)
          const sessionToken = generateSecureToken();
          Astro.cookies.set('admin_session', sessionToken, {
            httpOnly: true,
            secure: Astro.url.protocol === 'https:',
            sameSite: 'strict',
            path: '/',
            maxAge: 60 * 60 * 24 * 7, // 7 days
          });
          return Astro.redirect('/admin');
        } else {
          loginError = 'Incorrect password. Please try again.';
        }
      } else {
        loginError = 'Admin password not configured. Set ADMIN_PASSWORD_HASH.';
      }
    }

    // ── Logout ─────────────────────────────────────────────────────────
    if (action === 'logout') {
      Astro.cookies.delete('admin_session', { path: '/' });
      Astro.cookies.delete('csrf_token', { path: '/' });
      return Astro.redirect('/admin');
    }
  }
}
